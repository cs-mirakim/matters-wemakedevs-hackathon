# ==============================================================================
# Matters - Environment Configuration Template
# ==============================================================================

# FalkorDB Cloud (Primary Load-Bearing Graph Database)
FALKORDB_HOST="your-instance.falkordb.cloud"
FALKORDB_PORT=6379
FALKORDB_PASSWORD="your_falkordb_password"
FALKORDB_GRAPH_NAME="matters"

# Google Gemini API (Entity & Intent Extraction)
GEMINI_API_KEY="your_gemini_api_key_here"

# Firebase Client (Public configuration for Google OAuth)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id"

# Firebase Admin SDK (Server-side token verification - never expose to client!)
FIREBASE_ADMIN_PROJECT_ID="your_project_id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
